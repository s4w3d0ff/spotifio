# Copy to .env and fill in. ID and secret come from the Spotify dashboard.
SPOTIFIO_CLIENT_ID=
SPOTIFIO_CLIENT_SECRET=

# Loopback IP with an explicit port. Must match the app setting exactly.
SPOTIFIO_REDIRECT_URI=http://127.0.0.1:5050/spotify_oauth

# Space separated. A call outside these scopes raises ScopeError.
SPOTIFIO_SCOPES=user-read-email user-read-private user-library-read playlist-read-private playlist-modify-public
