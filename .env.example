# Copy this file to .env and fill it in. Client ID and Client Secret come from
# https://developer.spotify.com/dashboard, and the Redirect URI below must be
# added to that app's settings exactly as it appears here.
#
# One variable per line, and keep the final newline: a file whose last line has no
# newline glues the last two variables together and spotifio rejects the line.

SPOTIFIO_CLIENT_ID=
SPOTIFIO_CLIENT_SECRET=

# The callback server listens here, so it must be the loopback IP literal with an
# explicit port. Spotify rejects "localhost" and rejects a URI without a port.
SPOTIFIO_REDIRECT_URI=http://127.0.0.1:5050/spotify_oauth

# Space separated (commas are also accepted). Only the scopes listed here can be
# used; spotifio refuses a call whose scope was not granted.
SPOTIFIO_SCOPES=user-read-email user-read-private user-library-read playlist-read-private playlist-modify-public
